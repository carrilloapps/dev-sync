{
  "name": "agent-sync",
  "version": "1.0.0",
  "description": "Universal sync tool for AI coding agents and IDEs with MCP support",
  "license": "MIT",
  "author": "José Carrillo <m@carrillo.app> (https://carrillo.app)",
  "repository": {
    "type": "git",
    "url": "https://github.com/carrilloapps/agent-sync"
  },
  "homepage": "https://github.com/carrilloapps/agent-sync#readme",
  "bugs": {
    "url": "https://github.com/carrilloapps/agent-sync/issues"
  },
  "keywords": [
    "ai",
    "claude",
    "copilot",
    "gemini",
    "mcp",
    "sync",
    "ide",
    "cursor",
    "opencode",
    "agent",
    "coding-agent",
    "vscode",
    "jetbrains"
  ],
  "bin": {
    "agent-sync": "dist/cli.js",
    "agent-sync-mcp": "dist/mcp/cli.js"
  },
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc && tsc-alias",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "mcp": "node dist/mcp/cli.js",
    "typecheck": "tsc --noEmit",
    "lint": "xo",
    "test": "ava",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "~1.29.0",
    "chokidar": "~3.6.0",
    "ink": "~4.4.1",
    "meow": "~14.1.0",
    "ora": "~5.4.1",
    "picocolors": "~1.1.1",
    "react": "~18.3.1"
  },
  "devDependencies": {
    "@types/node": "~20.17.0",
    "@types/react": "~18.3.12",
    "ava": "~5.3.1",
    "chalk": "~5.3.0",
    "eslint-config-xo-react": "~0.27.0",
    "eslint-plugin-react": "~7.37.2",
    "eslint-plugin-react-hooks": "~5.0.0",
    "prettier": "~3.3.3",
    "tsc-alias": "~1.8.10",
    "typescript": "~5.6.3",
    "xo": "~0.60.0"
  },
  "ava": {
    "environmentVariables": {
      "NODE_NO_WARNINGS": "1"
    },
    "files": [
      "dist/**/*.test.js"
    ],
    "timeout": "2m"
  },
  "xo": {
    "extends": "xo-react",
    "prettier": true,
    "rules": {
      "react/prop-types": "off",
      "@typescript-eslint/naming-convention": "off",
      "@typescript-eslint/no-unnecessary-type-assertion": "off",
      "@typescript-eslint/no-unsafe-assignment": "off",
      "@typescript-eslint/no-unsafe-argument": "off",
      "@typescript-eslint/no-unsafe-call": "off",
      "@typescript-eslint/parameter-properties": "off",
      "@typescript-eslint/use-unknown-in-catch-callback-variable": "off",
      "@typescript-eslint/prefer-nullish-coalescing": "off",
      "@typescript-eslint/restrict-template-expressions": "off",
      "@typescript-eslint/return-await": "off",
      "@typescript-eslint/restrict-plus-operands": "off",
      "@typescript-eslint/no-unsafe-return": "off",
      "@typescript-eslint/no-floating-promises": "off",
      "@typescript-eslint/member-ordering": "off",
      "unicorn/prevent-abbreviations": "off",
      "unicorn/prefer-code-point": "off",
      "unicorn/no-object-as-default-parameter": "off",
      "unicorn/prefer-top-level-await": "off",
      "unicorn/no-array-callback-reference": "off",
      "unicorn/text-encoding-identifier-case": "off",
      "n/prefer-global/process": "off",
      "no-bitwise": "off",
      "react/boolean-prop-naming": "off",
      "react/hook-use-state": "off",
      "react/no-array-index-key": "off",
      "react/no-unused-state": "off",
      "max-depth": "off",
      "max-params": "off",
      "complexity": "off",
      "import/no-unassigned-import": "off"
    }
  }
}
